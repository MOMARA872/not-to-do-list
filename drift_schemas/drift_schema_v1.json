  "fixed_sql": [
    {
      "name": "block_list",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"block_list\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"kind\" INTEGER NOT NULL, \"package_name\" TEXT NULL, \"display_name\" TEXT NOT NULL, \"reason_note\" TEXT NOT NULL DEFAULT '', \"streak_break_threshold_minutes\" INTEGER NOT NULL DEFAULT 5, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, UNIQUE (\"kind\", \"package_name\"));"
        }
      ]
    },
    {
      "name": "daily_streak",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"daily_streak\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"entry_id\" INTEGER NOT NULL REFERENCES block_list (id) ON DELETE CASCADE, \"day\" INTEGER NOT NULL, \"status\" INTEGER NOT NULL, \"source\" INTEGER NOT NULL, \"usage_minutes_observed\" INTEGER NOT NULL DEFAULT 0, \"evaluated_at\" INTEGER NOT NULL, UNIQUE (\"entry_id\", \"day\"));"
        }
      ]
    },
    {
      "name": "pause_events",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"pause_events\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"entry_id\" INTEGER NOT NULL REFERENCES block_list (id) ON DELETE CASCADE, \"package_name\" TEXT NOT NULL, \"triggered_at\" INTEGER NOT NULL, \"cooldown_chosen_seconds\" INTEGER NULL, \"outcome\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "daily_checkins",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"daily_checkins\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"entry_id\" INTEGER NOT NULL REFERENCES block_list (id) ON DELETE CASCADE, \"day\" INTEGER NOT NULL, \"avoided\" INTEGER NOT NULL CHECK (\"avoided\" IN (0, 1)), \"answered_at\" INTEGER NOT NULL, UNIQUE (\"entry_id\", \"day\"));"
        }
      ]
    },
    {
      "name": "daily_usage_summary",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"daily_usage_summary\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"package_name\" TEXT NOT NULL, \"day\" INTEGER NOT NULL, \"foreground_seconds\" INTEGER NOT NULL, \"launch_count\" INTEGER NOT NULL DEFAULT 0, \"aggregated_at\" INTEGER NOT NULL, UNIQUE (\"package_name\", \"day\"));"
        }
      ]
    }
  ]
